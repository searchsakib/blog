---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';


---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="">
			<video autoplay muted loop class="hero-video">
				<source src="/typing.mp4" type="video/mp4">
				Your browser does not support the video tag.
			</video>
			<h2>Write anything...</h2>
			<p class="text">
				Write blogs about your favorite topics and win... nothing! Cause giving out prizes is pricey. Lol, jokes apart, write whatever makes you feel like an awesome blog writer , Or not, who cares.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>

	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		margin: 0;
	}
	
	main{
	flex: 1;
	}

	.a-tag{
		text-decoration: none;
	}
	
	.hero-video {
		width: 100%;
		max-width: 800px;
		margin: 1px auto;
		display: block;
		border-radius: 8px;
	}
	h2 {
		padding-top: 25px;
	}
</style>