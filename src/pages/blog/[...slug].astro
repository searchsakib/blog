---
import FormattedDate from '../../components/FormattedDate.astro';
import BlogPost from '../../layouts/BlogPost.astro';
import { client,urlFor } from '../../sanity/client';
import { toHTML } from '@portabletext/to-html';

export async function getStaticPaths() {
  const posts = await client.fetch(`
    *[_type == "blogPost"] {
      "params": {
        "slug": slug.current
      }
    }
  `);
  return posts;
}

const { slug } = Astro.params;

const post = await client.fetch(`
  *[_type == "blogPost" && slug.current == $slug][0] {
    title,
    content,
    author,
    coverImage,
    "createdAt": coalesce(createdAt, _createdAt),
    "updatedAt": coalesce(updatedAt, _updatedAt),
    category,
    tags
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const htmlContent = toHTML(post.content);
---

<BlogPost {...post}>
  <img src={urlFor(post.coverImage).width(800).url()} />
  {post.tags.map((tag)=> <span class="tags">{tag}</span>)}

  <div class="metadata">
    <div class="category">Category: {post.category}</div>
    <div class="author">Author: {post.author}</div>
    <div class="dates">
      <div>Published: <FormattedDate date={new Date(post.createdAt)} /></div>
      <div>Last updated: <FormattedDate date={new Date(post.updatedAt)} /></div>
    </div>
  </div>
  <div set:html={htmlContent}></div>
</BlogPost>

<style>
  .tags{
    padding: 1px 20px;
    margin: 20px 5px;
    border-radius: 7px;
    background-color: rgb(221, 221, 138);
  }
  .metadata {
    margin: 1rem 0;
    padding: 1rem;
    background-color: #f5f5f5;
    border-radius: 8px;
  }
  .dates {
    margin-top: 0.5rem;
    color: #666;
  }
</style>