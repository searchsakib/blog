---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';


---

<!doctype html>
<source lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			html, body {
				height: 100%;
				margin: 0;
				padding: 0;
			}
			body {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
			}
			main {
				flex: 1 0 auto;
			}
			.hero-video {
				width: 100%;
				max-width: 800px;
				margin: 1px auto;
				display: block;
				border-radius: 8px;
			}
			h2 {
				padding-top: 25px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="">
			<video autoplay muted loop class="hero-video">
				<source src="/typing.mp4" type="video/mp4">
				Your browser does not support the video tag.
			</video>
			<h2>Write anything...</h2>
			<p class="text">
				Write blogs about your favorite topics and win... nothing! Cause giving out prizes is pricey. Lol, jokes apart, write whatever makes you feel like an awesome blog writer , Or not, who cares.
			</p>
		</main>
		<Footer />
	</body>
</source>