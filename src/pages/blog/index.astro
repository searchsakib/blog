---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { client,urlFor } from '../../sanity/client';


interface BlogPost {
  title: string;
  slug: { current: string; _type: string };
  author: string;
  coverImage: {
    hotspot: any;
    _type: string;
    asset: any;
    crop: any;
  };
  excerpt: string;
  category: string;
  tags: string[];
  createdAt: string;
}

// Add console.log to debug the posts data
const posts = await client.fetch<BlogPost[]>(`*[_type == "blogPost" && isPublished == true] | order(coalesce(createdAt, _createdAt) desc) {
  title,
  slug,
  author,
  coverImage,
  "excerpt": array::join(string::split(pt::text(content[0...2]), "")[0...100], "") + "...",
  category,
  tags,
  "createdAt": coalesce(createdAt, _createdAt)
}`);
// console.log('Fetched posts:', posts);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{posts.map((post: BlogPost) => (
					<div class="card">
						<a class="a-tag" href={`/blog/${post.slug.current}`} class="post-link">

							<img src={urlFor(post.coverImage).width(500).url()} />
							<h5>
								{post.title}
							</h5>
							<p>
								{post.excerpt}
							</p>
							<p class="link">see more...</p>
						</a>
					</div>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>


<style>
section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    padding: 1rem;
}

.card {
    background-color: #d3c8ff15;
    border: 3px solid #1F1D28;
    border-radius: 10px;
    padding: 20px;
    transition: transform 0.2s ease;
}

.card:hover {
    transform: translateY(-5px);
}

.card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
}

.a-tag {
    text-decoration: none;
    color: black;
}

.link {
    color: var(--accent);
}

@media (max-width: 480px) {
    section {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 0.5rem;
    }
    
    .card {
        padding: 15px;
    }
}
</style>